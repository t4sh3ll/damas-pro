{
  "name": "damas-pro",
  "version": "1.0.0",
  "description": "Professional Checkers Game - Created with REA + Harness²",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --coverage",
    "test:e2e": "cypress run",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "analyze": "rea analyze ./src --output ./evidence",
    "benchmark": "harness2 --bench custom-damas --k 5 --mode parallel"
  },
  "keywords": ["damas", "checkers", "game", "board-game"],
  "author": "ML Soluções",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "cypress": "^13.6.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "vite": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
